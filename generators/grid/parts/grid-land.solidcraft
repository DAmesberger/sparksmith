  "name": "Land grid array",
  "units": "mm",
  "params": [
    {
      "name": "rows",
      "expr": "4",
      "unit": "",
      "comment": "rows of contacts (y), A from +y",
      "model": false
    },
    {
      "name": "columns",
      "expr": "5",
      "unit": "",
      "comment": "columns of contacts (x), 1 from −x",
      "model": false
    },
    {
      "name": "pitch",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "pitch along a row (x)",
      "model": false
    },
    {
      "name": "row_pitch",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "pitch between rows (y)",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "5 mm",
      "unit": "mm",
      "comment": "body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "4 mm",
      "unit": "mm",
      "comment": "body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "body height above the contacts",
      "model": false
    },
    {
      "name": "contact_diameter",
      "expr": "0.4 mm",
      "unit": "mm",
      "comment": "ball or land diameter",
      "model": false
    },
    {
      "name": "contact_height",
      "expr": "0.03 mm",
      "unit": "mm",
      "comment": "land thickness, set into the body",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.05 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "mark_radius",
      "expr": "0.24 mm",
      "unit": "mm",
      "comment": "A1 dimple radius",
      "model": false
    },
    {
      "name": "mark_depth",
      "expr": "0.03 mm",
      "unit": "mm",
      "comment": "A1 dimple depth",
      "model": false
    },
    {
      "name": "land_proud",
      "expr": "contact_height / 3",
      "unit": "mm",
      "comment": "how far the lands stand proud of the body's underside",
      "model": false
    }
  ],
