{
  "format": "solidcraft/57",
  "format_pending": [
    "cell-grid-margin",
    "extrude-to-object-keeps-picked-placements",
    "hole-thread-class",
    "linked-configuration",
    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "SOT-23 and SC-70 package",
  "units": "mm",
  "params": [
    {
      "name": "pitch",
      "expr": "0.95 mm",
      "unit": "mm",
      "comment": "the lead grid's pitch along x",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "2.9 mm",
      "unit": "mm",
      "comment": "moulded body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "moulded body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "1.1 mm",
      "unit": "mm",
      "comment": "moulded body height above the standoff",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0.075 mm",
      "unit": "mm",
      "comment": "body bottom above the seating plane",
      "model": false
    },
    {
      "name": "span",
      "expr": "2.8 mm",
      "unit": "mm",
      "comment": "lead tip to lead tip across y",
      "model": false
    },
    {
      "name": "lead_width",
      "expr": "0.4 mm",
      "unit": "mm",
      "comment": "lead width along x",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "lead thickness",
      "model": false
    },
    {
      "name": "foot_length",
      "expr": "0.4 mm",
      "unit": "mm",
      "comment": "a lead's foot on the seating plane",
      "model": false
    },
    {
      "name": "row_s_leads",
      "expr": "3",
      "unit": "",
      "comment": "leads on the −y side",
      "model": false
    },
    {
      "name": "row_s_step",
      "expr": "1",
      "unit": "",
      "comment": "grid positions between −y leads",
      "model": false
    },
    {
      "name": "row_n_leads",
      "expr": "2",
      "unit": "",
      "comment": "leads on the +y side",
      "model": false
    },
    {
      "name": "row_n_step",
      "expr": "2",
      "unit": "",
      "comment": "grid positions between +y leads",
      "model": false
    },
    {
      "name": "lead_exit",
      "expr": "standoff + body_height / 2",
      "unit": "mm",
      "comment": "height of the lead centreline where it leaves the body",
      "model": false
    },
    {
      "name": "draft",
      "expr": "8 deg",
      "unit": "deg",
      "comment": "mould draft of the walls above and below the parting line (Microchip SOT-23 and SOIC drawings: 5–15°)",
      "model": false
    },
    {
      "name": "draft_inset",
      "expr": "(standoff + body_height - lead_exit) * tan(draft)",
      "unit": "mm",
      "comment": "how far the top face's edge lies in from the parting line's",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "max(min(0.2 mm, 0.1 * body_width), draft_inset + 0.04 mm)",
      "unit": "mm",
      "comment": "round of the body's upright corners at the parting line",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "min(0.1 mm, 0.08 * body_height, (standoff + body_height - lead_exit - lead_thickness / 2) / 2, 0.6 * (corner_round - draft_inset))",
      "unit": "mm",
      "comment": "round of the body's top edges, clear of the lead exit and the top's corner arcs",
      "model": false
    },
    {
      "name": "half_body",
      "expr": "body_width / 2",
      "unit": "mm",
      "comment": "half the body width",
      "model": false
    },
    {
      "name": "lead_root",
      "expr": "min(0.25 mm, half_body / 3)",
      "unit": "mm",
      "comment": "how far a lead reaches into the body",
      "model": false
    },
    {
      "name": "lead_drop",
      "expr": "lead_exit - lead_thickness / 2",
      "unit": "mm",
      "comment": "the slope's drop from the exit to the foot",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "0.8 * (body_length - 2 * draft_inset)",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.7 * (body_width - 2 * draft_inset)",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
      "name": "lead_foot_in",
      "expr": "span / 2 - foot_length",
      "unit": "mm",
      "comment": "where the foot starts, across y",
      "model": false
    },
    {
      "name": "lead_shoulder",
      "expr": "half_body + 0.3 * (lead_foot_in - half_body)",
      "unit": "mm",
      "comment": "where the lead bends down, across y",
      "model": false
    },
    {
      "name": "lead_dx",
      "expr": "lead_foot_in - lead_shoulder",
      "unit": "mm",
      "comment": "the slope's run across y",
      "model": false
    },
    {
      "name": "lead_slope",
      "expr": "hypot(lead_dx, lead_drop)",
      "unit": "mm",
      "comment": "the slope's length",
      "model": false
    },
    {
      "name": "lead_k",
      "expr": "lead_drop / (lead_slope + lead_dx)",
      "unit": "",
      "comment": "tan of half the bend angle",
      "model": false
    },
    {
      "name": "lead_r1",
      "expr": "max(min(lead_thickness, 0.45 * min(lead_shoulder - (half_body - lead_root), lead_slope) / lead_k), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "the shoulder bend's centreline radius",
      "model": false
    },
    {
      "name": "lead_r2",
      "expr": "max(min(lead_thickness, 0.45 * min(lead_slope, foot_length) / lead_k), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "the foot bend's centreline radius",
      "model": false
    },
    {
      "name": "lead_miter",
      "expr": "lead_thickness / 2 * lead_k",
      "unit": "mm",
      "comment": "how far the outline's sharp corners lie past the centreline's",
      "model": false
    },
    {
      "name": "d2",
      "expr": "corner_round",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d9",
      "expr": "lead_r1 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d10",
      "expr": "lead_r2 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d11",
      "expr": "lead_r2 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d12",
      "expr": "lead_r1 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d16",
      "expr": "lead_r1 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d17",
      "expr": "lead_r2 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d18",
      "expr": "lead_r2 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d19",
      "expr": "lead_r1 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    }
  ],
