{
  "format": "solidcraft/52",
  "format_pending": [
    "3d-wire-point-nodes",
    "frame-end-caps",
    "joint-origin-inside",
    "nested-face-name",
    "opus-quality",
    "render-indirect-clamp",
    "render-quality-controls",
    "revolve-axis-sketch",
    "sheet-flange-segments",
    "sketch-link-construction-point",
    "two-sided-cut-cap-names"
  ],
  "name": "SOT-23 and SC-70 package",
  "units": "mm",
  "params": [
    {
      "name": "pitch",
      "expr": "0.95 mm",
      "unit": "mm",
      "comment": "the lead grid's pitch along x",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "2.9 mm",
      "unit": "mm",
      "comment": "moulded body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "moulded body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "1.1 mm",
      "unit": "mm",
      "comment": "moulded body height above the standoff",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0.075 mm",
      "unit": "mm",
      "comment": "body bottom above the seating plane",
      "model": false
    },
    {
      "name": "span",
      "expr": "2.8 mm",
      "unit": "mm",
      "comment": "lead tip to lead tip across y",
      "model": false
    },
    {
      "name": "lead_width",
      "expr": "0.4 mm",
      "unit": "mm",
      "comment": "lead width along x",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "lead thickness",
      "model": false
    },
    {
      "name": "foot_length",
      "expr": "0.4 mm",
      "unit": "mm",
      "comment": "a lead's foot on the seating plane",
      "model": false
    },
    {
      "name": "row_s_leads",
      "expr": "3",
      "unit": "",
      "comment": "leads on the −y side",
      "model": false
    },
    {
      "name": "row_s_step",
      "expr": "1",
      "unit": "",
      "comment": "grid positions between −y leads",
      "model": false
    },
    {
      "name": "row_n_leads",
      "expr": "2",
      "unit": "",
      "comment": "leads on the +y side",
      "model": false
    },
    {
      "name": "row_n_step",
      "expr": "2",
      "unit": "",
      "comment": "grid positions between +y leads",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "round of the body's upright corners",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.12 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "lead_exit",
      "expr": "standoff + body_height / 2",
      "unit": "mm",
      "comment": "height of the lead centreline where it leaves the body",
      "model": false
    },
    {
      "name": "half_body",
      "expr": "body_width / 2",
      "unit": "mm",
      "comment": "half the body width",
      "model": false
    },
    {
      "name": "lead_root",
      "expr": "min(0.25 mm, half_body / 3)",
      "unit": "mm",
      "comment": "how far a lead reaches into the body",
      "model": false
    },
    {
      "name": "lead_drop",
      "expr": "lead_exit - lead_thickness / 2",
      "unit": "mm",
      "comment": "the slope's drop from the exit to the foot",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "0.8 * body_length",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.8 * body_width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
      "name": "lead_foot_in",
      "expr": "span / 2 - foot_length",
      "unit": "mm",
      "comment": "where the foot starts, across y",
      "model": false
    },
    {
      "name": "lead_shoulder",
      "expr": "half_body + 0.3 * (lead_foot_in - half_body)",
      "unit": "mm",
      "comment": "where the lead bends down, across y",
      "model": false
    },
    {
      "name": "lead_dx",
      "expr": "lead_foot_in - lead_shoulder",
      "unit": "mm",
      "comment": "the slope's run across y",
      "model": false
    },
    {
      "name": "lead_slope",
      "expr": "hypot(lead_dx, lead_drop)",
      "unit": "mm",
      "comment": "the slope's length",
      "model": false
    },
    {
      "name": "lead_k",
      "expr": "lead_drop / (lead_slope + lead_dx)",
      "unit": "",
      "comment": "tan of half the bend angle",
      "model": false
    },
    {
      "name": "lead_r1",
      "expr": "max(min(lead_thickness, 0.45 * min(lead_shoulder - (half_body - lead_root), lead_slope) / lead_k), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "the shoulder bend's centreline radius",
      "model": false
    },
    {
      "name": "lead_r2",
      "expr": "max(min(lead_thickness, 0.45 * min(lead_slope, foot_length) / lead_k), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "the foot bend's centreline radius",
      "model": false
    },
    {
      "name": "lead_miter",
      "expr": "lead_thickness / 2 * lead_k",
      "unit": "mm",
      "comment": "how far the outline's sharp corners lie past the centreline's",
      "model": false
    },
    {
      "name": "d5",
      "expr": "lead_r1 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d6",
      "expr": "lead_r2 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d7",
      "expr": "lead_r2 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d8",
      "expr": "lead_r1 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d12",
      "expr": "lead_r1 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d13",
      "expr": "lead_r2 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d14",
      "expr": "lead_r2 + lead_thickness / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d15",
      "expr": "lead_r1 - lead_thickness / 2",
      "unit": "mm",
      "model": true
    }
  ],
  "features": [
    {
      "id": 1,
      "name": "body",
      "suppressed": false,
      "body_names": [
        "body"
      ],
      "param_names": [
        "d1",
        "d2",
        "d3"
      ],
      "type": "box",
      "corner": [
        "- body_length / 2",
        "- body_width / 2",
        "standoff"
      ],
      "length": "body_length",
      "width": "body_width",
      "height": "body_height",
      "operation": "new_body"
    },
