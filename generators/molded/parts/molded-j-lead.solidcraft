  "name": "Molded two-terminal, J-leads",
  "units": "mm",
  "params": [
    {
      "name": "body_length",
      "expr": "4.3 mm",
      "unit": "mm",
      "comment": "moulded body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "2.6 mm",
      "unit": "mm",
      "comment": "moulded body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "2.2 mm",
      "unit": "mm",
      "comment": "body top above the seating plane",
      "model": false
    },
    {
      "name": "span",
      "expr": "5.2 mm",
      "unit": "mm",
      "comment": "overall length, tip to tip",
      "model": false
    },
    {
      "name": "terminal_length",
      "expr": "1.1 mm",
      "unit": "mm",
      "comment": "terminal contact length on the seating plane, from the tip",
      "model": false
    },
    {
      "name": "terminal_width",
      "expr": "1.4 mm",
      "unit": "mm",
      "comment": "terminal width (y)",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "leadframe thickness",
      "model": false
    },
    {
      "name": "lead_root",
      "expr": "0.25 mm",
      "unit": "mm",
      "comment": "how far a lead reaches into the body",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "round of the body's upright corners",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "lead_exit",
      "expr": "1.1 mm",
      "unit": "mm",
      "comment": "height of the lead's centre line where it leaves the body",
      "model": false
    },
    {
      "name": "bend_1",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "centre-line radius of the bend at the body",
      "model": false
    },
    {
      "name": "bend_2",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "centre-line radius of the bend at the foot",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "(body_length / 2 - 0.08 * body_length) - (- body_length / 2 + 0.08 * body_length)",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.8 * body_width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    }
  ],
