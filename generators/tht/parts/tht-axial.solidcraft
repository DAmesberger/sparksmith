  "name": "Axial through-hole part",
  "units": "mm",
  "params": [
    {
      "name": "lead_pitch",
      "expr": "10.16 mm",
      "unit": "mm",
      "comment": "lead pitch on the board",
      "model": false
    },
    {
      "name": "lead_diameter",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "lead diameter (a strip's width, a square lead's side)",
      "model": false
    },
    {
      "name": "lead_below",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "lead length below the seating plane",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0 mm",
      "unit": "mm",
      "comment": "body underside above the seating plane",
      "model": false
    },
    {
      "name": "root",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "how far each lead reaches into the body",
      "model": false
    },
    {
      "name": "body_diameter",
      "expr": "2.5 mm",
      "unit": "mm",
      "comment": "body diameter",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "6.5 mm",
      "unit": "mm",
      "comment": "body length along x",
      "model": false
    },
    {
      "name": "bend_radius",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "centreline radius of the lead bends",
      "model": false
    },
    {
      "name": "end_round",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "round of the body's end edges",
      "model": false
    },
    {
      "name": "d2",
      "expr": "body_diameter / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "lead1_r1",
      "expr": "max(min(bend_radius, 0.45 * min(abs(((-(lead_pitch / 2)) - (-(body_length / 2 - root)))), abs(((- lead_below) - (standoff + body_diameter / 2)))) / 1), (lead_diameter / 2) * 1.0001)",
      "unit": "mm",
      "comment": "lead1 bend 1: centreline radius",
      "model": false
    },
    {
      "name": "lead1_t1",
      "expr": "lead1_r1",
      "unit": "mm",
      "comment": "lead1 bend 1: tangent length",
      "model": false
    },
    {
      "name": "lead2_r1",
      "expr": "max(min(bend_radius, 0.45 * min(abs(((lead_pitch / 2) - (body_length / 2 - root))), abs(((- lead_below) - (standoff + body_diameter / 2)))) / 1), (lead_diameter / 2) * 1.0001)",
      "unit": "mm",
      "comment": "lead2 bend 1: centreline radius",
      "model": false
    },
    {
      "name": "lead2_t1",
      "expr": "lead2_r1",
      "unit": "mm",
      "comment": "lead2 bend 1: tangent length",
      "model": false
    }
  ],
