      "unit": "mm",
      "comment": "body underside above the seating plane",
      "model": false
    },
    {
      "name": "root",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "how far each lead reaches into the body",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "10 mm",
      "unit": "mm",
      "comment": "body length along the row (x)",
      "model": false
    },
    {
