      "comment": "body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "15.5 mm",
      "unit": "mm",
      "comment": "body height above its standoff",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "round of the body's upright corners",
      "model": false
    },
    {
      "name": "edge_round",
