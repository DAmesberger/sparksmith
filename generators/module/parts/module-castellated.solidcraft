{
  "format": "solidcraft/57",
  "format_pending": [
    "cell-grid-margin",
    "extrude-to-object-keeps-picked-placements",
    "hole-thread-class",
    "linked-configuration",
    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "Castellated radio module",
  "units": "mm",
  "params": [
    {
      "name": "width",
      "expr": "18 mm",
      "unit": "mm",
      "comment": "module outline across (x)",
      "model": false
    },
    {
      "name": "length",
      "expr": "25 mm",
      "unit": "mm",
      "comment": "module outline along (y); the antenna end is +y",
      "model": false
    },
    {
      "name": "height",
      "expr": "3.2 mm",
      "unit": "mm",
      "comment": "seated height: pads, board and can",
      "model": false
    },
    {
      "name": "board_thickness",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "module board thickness",
      "model": false
    },
    {
      "name": "pad_thickness",
      "expr": "0.035 mm",
      "unit": "mm",
      "comment": "pad thickness under the board (est.: ENIG over 35 µm copper)",
      "model": false
    },
    {
      "name": "can_width",
      "expr": "16.6 mm",
      "unit": "mm",
      "comment": "shield can across (x)",
      "model": false
    },
    {
      "name": "can_length",
      "expr": "17.4 mm",
      "unit": "mm",
      "comment": "shield can along (y)",
      "model": false
    },
    {
      "name": "can_x",
      "expr": "0 mm",
      "unit": "mm",
      "comment": "shield can centre x",
      "model": false
    },
    {
      "name": "can_y",
      "expr": "-2.5 mm",
      "unit": "mm",
      "comment": "shield can centre y",
      "model": false
    },
    {
      "name": "can_height",
      "expr": "height - board_thickness - pad_thickness",
      "unit": "mm",
      "comment": "shield can height above the board",
      "model": false
    },
    {
      "name": "can_round",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "round of the can's top edges",
      "model": false
    },
    {
      "name": "can_emboss_inset",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "the stamped emboss groove's inset from the can's sides",
      "model": false
    },
    {
      "name": "can_emboss_width",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "the emboss groove's width (est.)",
      "model": false
    },
    {
      "name": "can_emboss_depth",
      "expr": "0.05 mm",
      "unit": "mm",
      "comment": "the emboss groove's depth (est.)",
      "model": false
    },
    {
      "name": "pitch",
      "expr": "1.27 mm",
      "unit": "mm",
      "comment": "pad pitch within every row",
      "model": false
    },
    {
      "name": "pad_length",
      "expr": "1.2 mm",
      "unit": "mm",
      "comment": "row pad across its edge",
      "model": false
    },
    {
      "name": "pad_width",
      "expr": "0.9 mm",
      "unit": "mm",
      "comment": "row pad along its edge",
      "model": false
    },
    {
      "name": "park_x",
      "expr": "-109 mm",
      "unit": "mm",
      "comment": "x where what the module does not have is placed and cut away",
      "model": false
    },
    {
      "name": "antenna_length",
      "expr": "6 mm",
      "unit": "mm",
      "comment": "antenna region depth from the +y edge",
      "model": false
    },
    {
      "name": "antenna_margin",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "meander inset in the antenna region (est.)",
      "model": false
    },
    {
      "name": "antenna_trace",
      "expr": "0.45 mm",
      "unit": "mm",
      "comment": "antenna trace width (est.)",
      "model": false
    },
    {
      "name": "antenna_thickness",
      "expr": "0.035 mm",
      "unit": "mm",
      "comment": "antenna trace thickness (est.: 35 µm copper)",
      "model": false
    },
    {
      "name": "antenna_turns",
      "expr": "6",
      "unit": "",
      "comment": "meander turns",
      "model": false
    },
    {
      "name": "antenna_units",
      "expr": "5",
      "unit": "",
      "comment": "copies of one turn between the head and the tail (turns − 1, at least 1)",
      "model": false
    },
    {
      "name": "antenna_step",
      "expr": "1.3666666666666665 mm",
      "unit": "mm",
      "comment": "meander step along x",
      "model": false
    },
    {
      "name": "antenna_shift",
      "expr": "0 mm",
      "unit": "mm",
      "comment": "antenna x shift (to park_x when there is none)",
      "model": false
    },
    {
      "name": "antenna_unit_shift",
      "expr": "0 mm",
      "unit": "mm",
      "comment": "x shift of the turn copies (to park_x for a one-turn meander)",
      "model": false
    },
    {
      "name": "ant_s",
      "expr": "antenna_step",
      "unit": "mm",
      "comment": "meander step along x",
      "model": false
    },
    {
      "name": "ant_h",
      "expr": "antenna_trace / 2",
      "unit": "mm",
      "comment": "half the trace width",
      "model": false
    },
    {
      "name": "ant_r",
      "expr": "ant_h * 1.0001",
      "unit": "mm",
      "comment": "bend radius of the trace's centreline",
      "model": false
    },
    {
      "name": "ant_ro",
      "expr": "ant_r + ant_h",
      "unit": "mm",
      "comment": "outer bend radius",
      "model": false
    },
    {
      "name": "ant_x0",
      "expr": "- width / 2 + antenna_margin + antenna_shift",
      "unit": "mm",
      "comment": "meander start x",
      "model": false
    },
    {
      "name": "antenna_depth",
      "expr": "6 mm",
      "unit": "mm",
      "comment": "depth of the region the meander is drawn in: the antenna region's, or room for a parked one",
      "model": false
    },
    {
      "name": "ant_y0",
      "expr": "length / 2 - antenna_depth + antenna_margin",
      "unit": "mm",
      "comment": "feed leg foot y",
      "model": false
    },
    {
      "name": "ant_y1",
      "expr": "length / 2 - antenna_margin",
      "unit": "mm",
      "comment": "meander top y",
      "model": false
    },
    {
      "name": "ant_yl",
      "expr": "ant_y0 + 0.4 * (ant_y1 - ant_y0)",
      "unit": "mm",
      "comment": "meander bottom y",
      "model": false
    },
    {
      "name": "ant_ux",
      "expr": "ant_x0 + antenna_unit_shift",
      "unit": "mm",
      "comment": "first turn copy x",
      "model": false
    },
    {
      "name": "ant_tx",
      "expr": "ant_x0 + 2 * (antenna_turns - 1) * antenna_step",
      "unit": "mm",
      "comment": "tail x",
      "model": false
    },
    {
      "name": "ground_rows",
      "expr": "3",
      "unit": "",
      "comment": "ground array rows",
      "model": false
    },
    {
      "name": "ground_columns",
      "expr": "3",
      "unit": "",
      "comment": "ground array columns",
      "model": false
    },
    {
      "name": "ground_pitch_x",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "ground pitch along the array's x",
      "model": false
    },
    {
      "name": "ground_pitch_y",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "ground pitch along the array's y",
      "model": false
    },
    {
      "name": "ground_size_x",
      "expr": "1.1 mm",
      "unit": "mm",
      "comment": "ground pad size along the array's x",
      "model": false
    },
    {
      "name": "ground_size_y",
      "expr": "1.1 mm",
      "unit": "mm",
      "comment": "ground pad size along the array's y",
      "model": false
    },
    {
      "name": "mark_pcb_depth",
      "expr": "6.3 mm",
      "unit": "mm",
      "comment": "board beyond the can's +y end (the pcb-top marking plane; 1 µm where the can reaches the edge)",
      "model": false
    },
    {
      "name": "mark_antenna_depth",
      "expr": "6 mm",
