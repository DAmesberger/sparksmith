    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "Chip LED body",
  "units": "mm",
  "params": [
    {
      "name": "length",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "length over the terminations (x)",
      "model": false
    },
    {
      "name": "width",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "width (y)",
      "model": false
    },
    {
      "name": "height",
      "expr": "0.75 mm",
      "unit": "mm",
      "comment": "height above the seating plane",
      "model": false
    },
    {
      "name": "termination",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "each termination's length, end cap and band",
      "model": false
    },
    {
      "name": "body_round",
      "expr": "0.045 mm",
      "unit": "mm",
      "comment": "round of the body's long edges",
      "model": false
    },
    {
      "name": "end_round",
      "expr": "0.0675 mm",
      "unit": "mm",
      "comment": "round of the terminations' outer edges",
      "model": false
    },
    {
      "name": "plating",
      "expr": "min(0.015 mm, 0.04 * height, termination / 10)",
      "unit": "mm",
      "comment": "how far the terminations stand proud of the body (est.: tin over nickel over the silver base)",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "length - 2 * termination - 0.1 mm",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.7 * width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
      "name": "substrate",
      "expr": "0.25 mm",
      "unit": "mm",
      "comment": "the LED's substrate thickness",
      "model": false
    },
    {
      "name": "lens_round",
      "expr": "0.1 mm",
      "unit": "mm",
      "comment": "round of the lens's top edges",
      "model": false
    },
    {
      "name": "die",
      "expr": "min(0.25 mm, width / 3, length - 2 * termination - 0.1 mm)",
      "unit": "mm",
      "comment": "the LED die's side (est.)",
      "model": false
    }
  ],
