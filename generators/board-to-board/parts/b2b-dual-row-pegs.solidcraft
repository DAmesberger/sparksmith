  "name": "Dual-row SMD terminal strip with alignment pins",
  "units": "mm",
  "params": [
    {
      "name": "positions",
      "expr": "4",
      "unit": "",
      "comment": "positions per row (x)",
      "model": false
    },
    {
      "name": "pitch",
      "expr": "2.54 mm",
      "unit": "mm",
      "comment": "pitch along a row",
      "model": false
    },
    {
      "name": "row_pitch",
      "expr": "2.54 mm",
      "unit": "mm",
      "comment": "pitch between the rows",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "10.16 mm",
      "unit": "mm",
      "comment": "insulator along x, centred",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "5.08 mm",
      "unit": "mm",
      "comment": "insulator along y, centred",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "1.27 mm",
      "unit": "mm",
      "comment": "insulator's bottom",
      "model": false
    },
    {
      "name": "body_top",
      "expr": "3.81 mm",
      "unit": "mm",
      "comment": "insulator's top",
      "model": false
    },
    {
      "name": "post_side",
      "expr": "0.64 mm",
      "unit": "mm",
      "comment": "square post side, also the tails' section",
      "model": false
    },
    {
      "name": "post_top",
      "expr": "14.48 mm",
      "unit": "mm",
      "comment": "posts' tips",
      "model": false
    },
    {
      "name": "z_split",
      "expr": "2.54 mm",
      "unit": "mm",
      "comment": "where posts meet their tails, inside the insulator",
      "model": false
    },
    {
      "name": "tail_tip",
      "expr": "3.72 mm",
      "unit": "mm",
      "comment": "tails' tips from the centre line",
      "model": false
    },
    {
      "name": "bend_r",
      "expr": "0.64 mm",
      "unit": "mm",
      "comment": "tails' bends' centreline radius",
      "model": false
    },
    {
      "name": "pocket",
      "expr": "1.152 mm",
      "unit": "mm",
      "comment": "square pocket round each post",
      "model": false
    },
    {
      "name": "pocket_depth",
      "expr": "0.3175 mm",
      "unit": "mm",
      "comment": "pocket depth",
      "model": false
    },
    {
      "name": "groove_width",
      "expr": "0.381 mm",
      "unit": "mm",
      "comment": "grooves between positions, along x",
      "model": false
    },
    {
      "name": "groove_depth",
      "expr": "0.475 mm",
      "unit": "mm",
      "comment": "grooves' depth into the long faces",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.1 mm",
      "unit": "mm",
      "comment": "round of the insulator's upright corners",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "body_length * 0.6",
      "unit": "mm",
      "comment": "marking area along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "groove_depth",
      "unit": "mm",
      "comment": "marking area across it",
      "model": false
    },
    {
      "name": "peg_x",
      "expr": "2.54 mm",
      "unit": "mm",
      "comment": "alignment pins' x from the centre",
      "model": false
    },
    {
      "name": "peg_diameter",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "alignment pin at the insulator",
      "model": false
    },
    {
      "name": "peg_tip",
      "expr": "1.21 mm",
      "unit": "mm",
      "comment": "alignment pin at its tip",
      "model": false
    },
    {
      "name": "peg_bottom",
      "expr": "-1.27 mm",
      "unit": "mm",
      "comment": "alignment pins' tips",
      "model": false
    },
    {
      "name": "d30",
      "expr": "(bend_r) + (post_side / 2)",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d31",
