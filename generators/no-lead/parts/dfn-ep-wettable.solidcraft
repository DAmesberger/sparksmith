  ],
  "name": "DFN package with exposed pad, wettable flanks",
  "units": "mm",
  "params": [
    {
      "name": "terminals",
      "expr": "4",
      "unit": "",
      "comment": "terminals per long (±y) side",
      "model": false
    },
    {
      "name": "pitch",
      "expr": "0.65 mm",
      "unit": "mm",
      "comment": "terminal pitch",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "0.9 mm",
      "unit": "mm",
      "comment": "body height above the seating plane",
      "model": false
    },
    {
      "name": "terminal_length",
      "expr": "0.4 mm",
      "unit": "mm",
      "comment": "terminal length in from its outer end",
      "model": false
    },
    {
      "name": "terminal_width",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "terminal width along the edge",
      "model": false
    },
    {
      "name": "pullback",
      "expr": "0 mm",
      "unit": "mm",
      "comment": "how far the terminals' outer ends lie in from the body edge",
      "model": false
    },
    {
      "name": "frame",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "leadframe (terminal) thickness",
      "model": false
    },
    {
      "name": "plating",
      "expr": "0.01 mm",
      "unit": "mm",
      "comment": "finish under the terminals (matte tin 7–20 µm, est.)",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.03 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "mark_radius",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "pin-1 laser dot radius",
      "model": false
    },
    {
      "name": "mark_depth",
      "expr": "0.005 mm",
      "unit": "mm",
      "comment": "pin-1 laser dot depth",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "0.7 * body_length",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.5 * body_width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
      "name": "pad_length",
      "expr": "2.4 mm",
      "unit": "mm",
      "comment": "exposed pad length (x)",
      "model": false
    },
    {
      "name": "pad_width",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "exposed pad width (y)",
      "model": false
    },
    {
      "name": "flank_height",
      "expr": "0.1 mm",
      "unit": "mm",
      "comment": "the wettable flank's plated step: its height up the terminal's end",
      "model": false
    },
    {
      "name": "flank_depth",
      "expr": "0.05 mm",
      "unit": "mm",
      "comment": "the plated step's depth in from the terminal's end",
      "model": false
    }
  ],
