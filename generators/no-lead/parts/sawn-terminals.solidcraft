{
  "format": "solidcraft/57",
  "format_pending": [
    "cell-grid-margin",
    "extrude-to-object-keeps-picked-placements",
    "hole-thread-class",
    "linked-configuration",
    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "No-lead package, individually placed terminals",
  "units": "mm",
  "params": [
    {
      "name": "body_length",
      "expr": "2 mm",
      "unit": "mm",
      "comment": "body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "2 mm",
      "unit": "mm",
      "comment": "body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "0.75 mm",
      "unit": "mm",
      "comment": "body height above the seating plane",
      "model": false
    },
    {
      "name": "frame",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "leadframe (terminal) thickness",
      "model": false
    },
    {
      "name": "plating",
      "expr": "0.01 mm",
      "unit": "mm",
      "comment": "finish under the terminals (NiPdAu, est.)",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.03 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "mark_radius",
      "expr": "0.12 mm",
      "unit": "mm",
      "comment": "pin-1 laser dot radius",
      "model": false
    },
    {
      "name": "mark_depth",
      "expr": "0.005 mm",
      "unit": "mm",
      "comment": "pin-1 laser dot depth",
      "model": false
    },
    {
      "name": "mark_x",
      "expr": "-0.76 mm",
      "unit": "mm",
      "comment": "pin-1 dot centre x",
      "model": false
    },
    {
      "name": "mark_y",
      "expr": "-0.76 mm",
      "unit": "mm",
      "comment": "pin-1 dot centre y",
      "model": false
    },
    {
      "name": "park_x",
      "expr": "-100 mm",
      "unit": "mm",
      "comment": "where unused terminal slots wait, beyond the −x edge, to be cut away",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "0.7 * body_length",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.2 * body_width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
