  ],
  "name": "USB-C receptacle, USB 2.0 (GCT USB4105)",
  "units": "mm",
  "params": [
    {
      "name": "width",
      "expr": "8.94 mm",
      "unit": "mm",
      "comment": "shell across (x), over the stakes",
      "model": false
    },
    {
      "name": "depth",
      "expr": "7.35 mm",
      "unit": "mm",
      "comment": "shell deep (y), mating face at -y",
      "model": false
    },
    {
      "name": "height",
      "expr": "3.31 mm",
      "unit": "mm",
      "comment": "seated height",
      "model": false
    },
    {
      "name": "opening_w",
      "expr": "8.34 mm",
      "unit": "mm",
      "comment": "mating opening across",
      "model": false
    },
    {
      "name": "opening_h",
      "expr": "2.56 mm",
      "unit": "mm",
      "comment": "mating opening high",
      "model": false
    },
    {
      "name": "opening_z",
      "expr": "1.73 mm",
      "unit": "mm",
      "comment": "mating opening centre height",
      "model": false
    },
    {
      "name": "shell_t",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "shell sheet thickness",
      "model": false
    },
    {
      "name": "pitch",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "signal land pitch",
      "model": false
    },
    {
      "name": "land_y",
      "expr": "3.68 mm",
      "unit": "mm",
      "comment": "contact lands' centre line (y)",
      "model": false
    },
    {
      "name": "land_length",
      "expr": "1.15 mm",
      "unit": "mm",
      "comment": "contact land length (y)",
      "model": false
    },
    {
      "name": "signal_land_w",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "signal land width",
      "model": false
    },
    {
      "name": "power_land_w",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "shared VBUS and GND land width",
      "model": false
    },
    {
      "name": "vbus_x",
      "expr": "2.4 mm",
      "unit": "mm",
      "comment": "VBUS land centres from x = 0",
      "model": false
    },
    {
      "name": "gnd_x",
      "expr": "3.2 mm",
      "unit": "mm",
      "comment": "GND land centres from x = 0",
      "model": false
    },
    {
      "name": "front_y",
      "expr": "-1.075 mm",
      "unit": "mm",
      "comment": "front stake slot centre (y)",
      "model": false
    },
    {
      "name": "front_slot",
      "expr": "1.4 mm",
      "unit": "mm",
      "comment": "front stake slot length (y)",
      "model": false
    },
    {
      "name": "rear_y",
      "expr": "3.105 mm",
      "unit": "mm",
      "comment": "rear stake slot centre (y)",
      "model": false
    },
    {
      "name": "rear_slot",
      "expr": "1.7 mm",
      "unit": "mm",
      "comment": "rear stake slot length (y)",
      "model": false
    },
    {
      "name": "stake_length",
      "expr": "0.95 mm",
      "unit": "mm",
      "comment": "how far the stakes reach below the seating plane",
      "model": false
    },
    {
      "name": "peg_x",
      "expr": "2.89 mm",
      "unit": "mm",
      "comment": "locating peg centres from x = 0",
      "model": false
    },
    {
      "name": "peg_y",
      "expr": "2.605 mm",
      "unit": "mm",
      "comment": "locating peg centre (y)",
      "model": false
    },
    {
      "name": "peg_d",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "locating peg diameter",
      "model": false
    },
    {
      "name": "tongue_w",
      "expr": "opening_w * 0.8",
      "unit": "mm",
      "comment": "tongue across (estimate: about 6.7 mm in the 8.34 mm opening)",
      "model": false
    },
    {
      "name": "tongue_t",
      "expr": "opening_h * 0.27",
      "unit": "mm",
      "comment": "tongue thickness (estimate: about 0.7 mm)",
      "model": false
    },
    {
      "name": "tongue_recess",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "tongue tip behind the mating face (estimate)",
      "model": false
    },
    {
      "name": "insulator_depth",
      "expr": "2.5 mm",
      "unit": "mm",
      "comment": "insulator closing the shell's rear (estimate)",
      "model": false
    },
    {
      "name": "tail_t",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "solder tail thickness (estimate)",
      "model": false
    },
    {
      "name": "tail_under",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "how far the tails run under the shell's rear (estimate)",
      "model": false
    },
    {
      "name": "signal_tail_w",
      "expr": "signal_land_w * 2 / 3",
      "unit": "mm",
      "comment": "signal tail width: the drawing's 0.20 mm on its 0.30 mm land",
      "model": false
    },
    {
      "name": "power_tail_w",
      "expr": "power_land_w * 0.75",
      "unit": "mm",
      "comment": "shared tail width: the drawing's 0.45 mm on its 0.60 mm land",
      "model": false
    },
    {
      "name": "tail_end",
      "expr": "land_y + land_length * 0.4",
      "unit": "mm",
      "comment": "where the tails end, short of their lands' outer end",
      "model": false
    },
    {
      "name": "stake_clearance",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "how much shorter a stake is than its slot (estimate: 1.10 mm in the 1.40 mm slot)",
      "model": false
    },
    {
      "name": "shell_r",
      "expr": "opening_h / 2 + shell_t",
      "unit": "mm",
      "comment": "outer radius of the shell's round ends",
      "model": false
    },
    {
      "name": "stake_beyond",
      "expr": "min(max(width / 2 - shell_t - (opening_w / 2 + shell_t - shell_r), 0 mm), shell_r)",
      "unit": "mm",
      "comment": "how far a stake's inner face lies beyond the start of the shell's round end",
      "model": false
    },
    {
      "name": "stake_top",
      "expr": "opening_z - sqrt(shell_r * shell_r - stake_beyond * stake_beyond)",
      "unit": "mm",
      "comment": "where the shell's rounded underside meets the stakes",
      "model": false
    },
    {
      "name": "opening_u",
      "expr": "opening_w",
      "unit": "mm",
      "comment": "opening datum across: the plug's shell",
      "model": false
    },
    {
      "name": "opening_v",
      "expr": "opening_h",
      "unit": "mm",
      "comment": "opening datum high: the plug's shell",
      "model": false
    },
    {
      "name": "opening_r",
      "expr": "opening_h / 2",
      "unit": "mm",
      "comment": "opening datum corner radius: round ends",
      "model": false
    },
    {
      "name": "opening_depth",
      "expr": "1.85 mm",
      "unit": "mm",
      "comment": "opening datum depth: the plug's shell before its overmold (mating view, 1.85 min)",
      "model": false
    }
  ],
