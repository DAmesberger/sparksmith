  {
    "id": "setting/favourites",
    "title": "Favourites",
    "summary": "Favourites",
    "since": "0.1.0",
    "facts": {
      "kind": "setting",
      "schema": {
        "items": {
          "description": "A lineage's identity across sources: how favourites and recents are\nkeyed (never by path or name), and what `CatalogEntry::key` returns.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "A lineage of the open project.",
              "properties": {
                "lineage": {
                  "description": "A definition lineage. Opaque so the representation can change when shared\nlibrary folders need collision-free identities.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "source": {
                  "const": "project",
                  "type": "string"
                }
              },
              "required": [
                "source",
                "lineage"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A lineage of a library folder.",
              "properties": {
                "library": {
                  "description": "A library source's identity (S3, D1): random, generated once when the\nfolder is created and stored in its manifest. Never a path or name.\n\nWritten as 32 lower-case hex digits. The core never generates one:\n`sparksmith-io` draws them from the operating system and passes them\nin as values.",
                  "type": "string"
                },
                "lineage": {
                  "description": "A lineage's identity inside one library folder (S3, D1): random, so\ntwo git authors adding lineages never collide on a counter. Project\ncopies get fresh project `DefinitionId`s on import.\n\nWritten as 32 lower-case hex digits. The core never generates one:\n`sparksmith-io` draws them from the operating system and passes them\nin as values.",
                  "type": "string"
                },
                "source": {
                  "const": "library",
                  "type": "string"
                }
              },
              "required": [
                "source",
                "library",
                "lineage"
              ],
              "type": "object"
            }
          ]
        },
        "maxItems": 256,
        "type": "array"
      },
      "unit": null,
      "default": [],
      "source": "UserSettings default"
    }
  },
