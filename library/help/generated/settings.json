  {
    "id": "setting/impedance_tolerance_pct",
    "title": "Impedance tolerance",
    "summary": "How far routed impedance may stray from a net class's target, in percent, when the class states no tolerance (Settings › Rules); `None`: the shipped value ([`SettingsDefaults`]).",
    "since": "0.1.0",
    "facts": {
      "kind": "setting",
      "schema": {
        "description": "How far routed impedance may stray from a net class's target, in\npercent, when the class states no tolerance (Settings › Rules);\n`None`: the shipped value ([`SettingsDefaults`]).",
        "format": "double",
        "maximum": 50.0,
        "minimum": 0.5,
        "type": [
          "number",
          "null"
        ]
      },
      "unit": "%",
      "default": 10.0,
      "source": "How far routed impedance may stray from a net class's target, in percent, when the class states no tolerance of its own. ±10 % is the controlled-impedance tolerance fabricators commonly offer as standard, tighter values usually being a special order; it is also the value the impedance check used before it became a setting. Set your fabricator's stated tolerance in Settings."
    }
  },
  {
    "id": "setting/keyboard",
    "title": "Keyboard",
    "summary": "The user's keymap and the key-reveal overlays.",
    "since": "0.1.0",
    "facts": {
      "kind": "setting",
      "schema": {
        "additionalProperties": false,
        "description": "The user's keymap and the key-reveal overlays.",
        "properties": {
          "bindings": {
            "default": [],
            "description": "Only the changed commands, in id order.",
            "items": {
              "additionalProperties": false,
              "description": "One changed key: the command's registry id and its chord as\nSolidcraft's keymap names it (`Ctrl+Shift+S`), or `None` for no key.\nWhether the id and chord mean something is the app's to say: an entry\nit cannot apply is reported and kept, never dropped.",
              "properties": {
                "chord": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "command": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "format": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "reveal": {
            "additionalProperties": false,
            "default": {
              "hold_badges": true,
              "hold_ms": 500,
              "key_tips": true
            },
            "description": "Hold ⌘ to show key badges; tap ⌥ for key tips.",
            "properties": {
              "hold_badges": {
                "type": "boolean"
              },
              "hold_ms": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "key_tips": {
                "type": "boolean"
              }
            },
            "required": [
              "hold_badges",
              "hold_ms",
              "key_tips"
            ],
            "type": "object"
          }
        },
        "required": [
          "format"
        ],
        "type": "object"
      },
      "unit": null,
      "default": {
        "bindings": [],
        "format": 1,
        "reveal": {
          "hold_badges": true,
          "hold_ms": 500,
          "key_tips": true
        }
      },
      "source": "UserSettings default"
    }
  },
