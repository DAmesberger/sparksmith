{
  "format": 1,
  "id": "datasheet-to-component",
  "version": "1.1",
  "title": "Datasheet → component",
  "summary": "Draft a component, symbol, package, footprint, binding and 3D model from manufacturer datasheets, every value cited, for you to review and publish.",
  "intents": [
    "make a part from this datasheet",
    "create the component for this part number",
    "add this chip to my library"
  ],
  "offer_when": [{"attachment": "application/pdf"}],
  "needs": [
    {"module": "library", "major": 3, "minor": 1},
    {"module": "generators", "major": 1, "minor": 2},
    {"module": "assist", "major": 1}
  ],
  "reach": {"project": "read", "library": "edit", "generators": "edit", "assist": "edit", "view": "show"},
  "budget": {"requests": 40, "output_tokens": 200000, "minutes": 45},
  "inputs": {
    "datasheets": {"type": "files", "title": "Datasheets", "accept": ["application/pdf"], "min": 1, "max": 4},
    "part": {"type": "text", "title": "Part name", "help": "The manufacturer part number", "max": 64},
    "notes": {"type": "text", "title": "Notes", "help": "Package variant, what to leave out", "optional": true, "multiline": true, "max": 4096}
  },
  "outputs": {
    "package_plan": {
      "help": "The generator that makes the package, its preset and every value the drawing and the land pattern state.",
      "fields": {
        "generator": {"type": "text", "help": "A generator's name from library.generators"},
        "preset": {"type": "text", "optional": true, "help": "A preset of that generator, when one is the package"},
        "params": {"type": "object", "help": "Parameter values: lengths in integer nanometres, angles in integer millidegrees"},
        "pages": {"type": "text", "help": "The pages you found and read, by document: \"tlv757p.pdf: pinout 3, drawing 31, land pattern 32\""},
        "why": {"type": "text", "help": "One line: the package and where its values come from"}
      }
    },
    "pinout_document": {
      "help": "The pinout document, format 1, as library.pinout_schema describes it.",
      "fields": {"document": {"type": "object"}}
    },
    "review_report": {
      "help": "The review report, as library.review_check checks it.",
      "fields": {"report": {"type": "object"}}
    }
  },
  "steps": [
    {"id": "ask", "kind": "input", "title": "Inputs", "inputs": ["datasheets", "part", "notes"]},
    {"id": "read", "kind": "tool", "title": "Read", "call": "assist.document_text", "each": "/inputs/datasheets", "params": {"document": "/item/title"}},
    {"id": "gens", "kind": "tool", "title": "Generators", "call": "library.generators", "params": {}},
    {"id": "plan", "kind": "model", "title": "Package", "goal": "Find the pages with the pin layout, the mechanical drawing and the land pattern; choose the generator and preset that make the package and give every value the drawing and the land pattern state.", "method": "method.md#procedure", "output": "package_plan", "check": "make"},
    {"id": "pick", "kind": "review", "title": "Generator", "gate": "notify", "control": "choice", "show": "/steps/plan/generator", "options": {"list": "/steps/gens/shipped", "value": "/name", "title": "/title"}, "change": "plan"},
    {"id": "make", "kind": "tool", "title": "Made", "call": "library.generate_part", "params": {"generator": "/steps/plan/generator", "preset": "/steps/plan/preset", "params": "/steps/plan/params", "name": "/inputs/part", "scope": "component"}},
    {"id": "drafts", "kind": "tool", "title": "Drafts", "call": "library.draft_closure", "params": {"component": {"id": "/steps/make/outcome/report/root/id", "revision": "/steps/make/outcome/report/root/revision"}}},
    {"id": "pinout", "kind": "model", "title": "Pinout", "goal": "Write the pinout document: every pin's number, name, functions and rules, each with its page and table.", "method": "method.md#procedure", "output": "pinout_document", "check": "preview"},
    {"id": "preview", "kind": "tool", "title": "Preview", "call": "library.pinout_preview", "params": {"target": {"target": "draft", "id": "/steps/drafts/outcome/ids/0"}, "document": "/steps/pinout/document"}},
    {"id": "import", "kind": "review", "title": "Import", "gate": "confirm", "control": "impact", "plan": "/steps/preview/result", "then": {"call": "library.pinout_apply", "params": {"target": {"target": "draft", "id": "/steps/drafts/outcome/ids/0"}, "document": "/steps/pinout/document", "base": "/steps/preview/result/base", "accept": {"accept": "all"}}}},
    {"id": "check", "kind": "tool", "title": "Check", "call": "component.check_drafts", "params": {}},
    {"id": "report", "kind": "model", "title": "Report", "goal": "Write the review report: every value with its page and table, confidence and open questions.", "method": "method.md#the-review-report", "output": "review_report", "check": "accept"},
    {"id": "accept", "kind": "tool", "title": "Review", "call": "library.review_check", "params": {"report": "/steps/report/report"}},
    {"id": "done", "kind": "result", "title": "Done",
     "items": [
       {"title": "Drafts", "from": "/steps/drafts"},
       {"title": "Pages used", "from": "/steps/plan/pages"},
       {"title": "Findings", "from": "/steps/check"},
       {"title": "Review", "from": "/steps/accept"}
     ],
     "actions": [{"title": "Open in editor", "call": "view.open", "params": {"workspace": "component", "definition": "/steps/drafts/outcome/ids/0"}}]}
  ]
}
