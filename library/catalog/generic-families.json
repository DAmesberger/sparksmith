{
  "format": 1,
  "about": "The words that ask the part catalog for a generic part, made by a generator. Each family names its generator (the description's id) and declares its patterns with typed slots: {name} a count; {name:length} a length (mm unless it says); {name:code} a size code; {name:ohm}, {name:farad}, {name:henry}, {name:volt} a quantity of a value slot below; {colour:list} a colour of the colour field; {package:list} a preset of the generator named by its first word or an alias. A trailing ? makes a step optional. Patterns match the whole text, word by word, with no reordering. A size code or a listed package chooses a preset among those whose parameters include `presets` (a generator's only family may leave `presets` out and serve every part it makes); count and length slots fill the parameters `slots` names (else the parameter of the slot's name), starting from a preset that has them all, else one with the same lengths; `params` are given on top. `category` is the path in categories.json a part of the family is filed under; `label` names the part, `body` the two lengths its badge shows. `fields` are the standard fields a part of the family selects, each placed part holding its own values; `value_template` is what a placed part shows as its value, alternatives over those fields with {Field} placeholders, the first filled one winning. Examples must each build a part through the family's generator.",
  "families": [
    {
      "family": "header",
      "generator": "header",
      "category": "connectors/headers",
      "slots": { "pitch": ["pitch", "row_pitch"] },
      "label": "Pin header {rows}×{columns} {pitch} mm",
      "patterns": [
        "header {rows}x{columns} {pitch:length}?",
        "pin header {rows}x{columns} {pitch:length}?"
      ],
      "examples": ["header 1x4", "header 2x5 2mm", "pin header 1×3"]
    },
    {
      "family": "resistor",
      "generator": "chip",
      "category": "passives/resistors",
      "presets": { "part": "resistor" },
      "label": "Chip resistor {size}",
      "body": ["length", "width"],
      "patterns": ["resistor {size:code} {value:ohm}?", "{value:ohm} {size:code}"],
      "examples": ["resistor 0603", "resistor 0402 4k7", "10k 0603", "10 kΩ 0805"],
      "fields": ["Resistance", "Tolerance", "Rated power", "Temperature coefficient"],
      "value_template": ["{Resistance}"]
    },
    {
      "family": "capacitor",
      "generator": "chip",
      "category": "passives/capacitors",
      "presets": { "part": "capacitor" },
      "label": "Chip capacitor {size}",
      "body": ["length", "width"],
      "patterns": [
        "capacitor {size:code} {value:farad}? {voltage:volt}?",
        "{value:farad} {size:code} {voltage:volt}?"
      ],
      "examples": ["capacitor 0603", "100nF 0402", "100n 0603 16V"],
      "fields": ["Capacitance", "Rated voltage", "Tolerance", "Dielectric"],
      "value_template": ["{Capacitance} {Rated voltage}", "{Capacitance}"]
    },
    {
      "family": "inductor",
      "generator": "chip",
      "category": "magnetics/inductors",
      "presets": { "part": "ferrite" },
      "params": { "part": "inductor" },
      "label": "Chip inductor {size}",
      "body": ["length", "width"],
      "patterns": ["inductor {size:code} {value:henry}?", "{value:henry} {size:code}"],
      "examples": ["inductor 0603", "4.7uH 0805"],
      "fields": ["Inductance", "Rated current", "Tolerance"],
      "value_template": ["{Inductance}"]
    },
    {
      "family": "led",
      "generator": "chip",
      "category": "opto/leds",
      "presets": { "part": "led" },
      "label": "Chip LED {size}",
      "body": ["length", "width"],
      "patterns": ["led {size:code} {colour:list}?"],
      "examples": ["led 0603", "led 0805 red"],
      "fields": ["Colour", "Forward voltage"],
      "value_template": ["{Colour}"]
    },
    {
      "family": "diode",
      "generator": "molded",
      "category": "discretes/diodes",
      "presets": { "part": "diode" },
      "label": "Diode {package}",
      "body": ["body_length", "body_width"],
      "patterns": ["diode {package:list}"],
      "examples": ["diode sod-123", "diode sma"]
    },
    {
      "family": "tantalum",
      "generator": "molded",
      "category": "passives/capacitors",
      "presets": { "part": "polarised_capacitor" },
      "label": "Tantalum capacitor case {package}",
      "body": ["body_length", "body_width"],
      "patterns": [
        "tantalum {package:list} {value:farad}? {voltage:volt}?",
        "tantalum case {package:list} {value:farad}? {voltage:volt}?"
      ],
      "examples": ["tantalum B", "tantalum case A 10u 10V", "tantalum 7343-31 100u 16V"],
      "fields": ["Capacitance", "Rated voltage", "Tolerance"],
      "value_template": ["{Capacitance} {Rated voltage}", "{Capacitance}"]
    },
    {
      "family": "electrolytic",
      "generator": "electrolytic",
      "category": "passives/capacitors",
      "label": "Aluminium electrolytic {package}",
      "body": ["can_diameter", "height"],
      "patterns": ["electrolytic {package:list} {value:farad}? {voltage:volt}?"],
      "examples": ["electrolytic 6.3x5.8", "electrolytic 6.3x7.7 100u 16V"],
      "fields": ["Capacitance", "Rated voltage", "Tolerance"],
      "value_template": ["{Capacitance}"]
    },
    {
      "family": "electrolytic",
      "generator": "tht",
      "category": "passives/capacitors",
      "presets": { "construction": "radial", "symbol": "polarised_capacitor" },
      "label": "Radial electrolytic {package}",
      "body": ["body_diameter", "body_height"],
      "patterns": ["radial electrolytic {package:list} {value:farad}? {voltage:volt}?"],
      "examples": ["radial electrolytic 5x11", "radial electrolytic 8x11.5 470u 25V"],
      "fields": ["Capacitance", "Rated voltage", "Tolerance"],
      "value_template": ["{Capacitance}"]
    }
  ],
  "value_slots": [
    { "slot": "ohm", "field": "Resistance", "bare": ["", "m", "k", "M", "G"] },
    { "slot": "farad", "field": "Capacitance", "bare": ["p", "n", "u", "µ", "μ"] },
    { "slot": "henry", "field": "Inductance", "bare": ["n", "u", "µ", "μ", "m"] },
    { "slot": "volt", "field": "Rated voltage", "bare": [] }
  ],
  "colour_field": "Colour",
  "length_units": [
    { "symbol": "mm", "scale": 0.001 },
    { "symbol": "mil", "scale": 2.54e-5 },
    { "symbol": "in", "scale": 0.0254 }
  ],
  "header_pitch_mm": "2.54",
  "metric_alias": "{code} metric"
}
