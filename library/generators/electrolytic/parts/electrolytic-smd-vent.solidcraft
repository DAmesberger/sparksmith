{
  "format": "solidcraft/57",
  "format_pending": [
    "cell-grid-margin",
    "extrude-to-object-keeps-picked-placements",
    "hole-thread-class",
    "linked-configuration",
    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "Aluminium electrolytic capacitor, SMD, vent",
  "units": "mm",
  "params": [
    {
      "name": "can_diameter",
      "expr": "6.3 mm",
      "unit": "mm",
      "comment": "can diameter (D)",
      "model": false
    },
    {
      "name": "height",
      "expr": "5.8 mm",
      "unit": "mm",
      "comment": "overall height above the seating plane (L)",
      "model": false
    },
    {
      "name": "base_length",
      "expr": "6.6 mm",
      "unit": "mm",
      "comment": "seat plate along x (A)",
      "model": false
    },
    {
      "name": "base_width",
      "expr": "6.6 mm",
      "unit": "mm",
      "comment": "seat plate across (B)",
      "model": false
    },
    {
      "name": "base_height",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "seat plate height (est.)",
      "model": false
    },
    {
      "name": "base_bevel",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "bevel of the seat plate's + corners (est.)",
      "model": false
    },
    {
      "name": "span",
      "expr": "7.8 mm",
      "unit": "mm",
      "comment": "overall length over the terminals (H)",
      "model": false
    },
    {
      "name": "terminal_gap",
      "expr": "1.8 mm",
      "unit": "mm",
      "comment": "gap between the terminals (P)",
      "model": false
    },
    {
      "name": "terminal_width",
      "expr": "0.65 mm",
      "unit": "mm",
      "comment": "terminal width (W)",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "terminal thickness (est.)",
      "model": false
    },
    {
      "name": "bead_height",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "seal bead centre above the seat plate (est.)",
      "model": false
    },
    {
      "name": "bead_depth",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "seal bead depth (est.)",
      "model": false
    },
    {
      "name": "rim_round",
      "expr": "0.35 mm",
      "unit": "mm",
      "comment": "round of the can's rim (est.)",
      "model": false
    },
    {
      "name": "print_from",
      "expr": "0.15 * can_diameter",
      "unit": "mm",
      "comment": "x where the negative print begins (est.)",
      "model": false
    },
    {
      "name": "print_thickness",
      "expr": "0.02 mm",
      "unit": "mm",
      "comment": "negative print ink thickness (est.)",
      "model": false
    },
    {
      "name": "vent_length",
      "expr": "0.6 * can_diameter",
      "unit": "mm",
      "comment": "vent score length (est.)",
      "model": false
    },
    {
      "name": "vent_width",
      "expr": "0.12 mm",
      "unit": "mm",
      "comment": "vent score width at the top (est.)",
      "model": false
    },
    {
      "name": "vent_depth",
      "expr": "0.015 mm",
      "unit": "mm",
      "comment": "vent score depth, a V (est.)",
      "model": false
    },
    {
      "name": "d6",
      "expr": "can_diameter",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d10",
      "expr": "can_diameter + 1 mm",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d13",
      "expr": "can_diameter - 2 * bead_depth",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d16",
      "expr": "can_diameter - 2 * rim_round",
      "unit": "mm",
      "model": true
    },
    {
      "name": "marking_top_u",
      "expr": "print_from + can_diameter / 2 - rim_round",
      "unit": "mm",
      "comment": "marking area along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.6 * can_diameter",
      "unit": "mm",
      "comment": "marking area across it",
      "model": false
    }
  ],
