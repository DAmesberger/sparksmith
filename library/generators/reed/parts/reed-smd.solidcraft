  "name": "Reed switch, surface mount",
  "units": "mm",
  "params": [
    {
      "name": "tube_length",
      "expr": "15.24 mm",
      "unit": "mm",
      "comment": "glass envelope length",
      "model": false
    },
    {
      "name": "tube_diameter",
      "expr": "2.28 mm",
      "unit": "mm",
      "comment": "glass envelope diameter",
      "model": false
    },
    {
      "name": "height",
      "expr": "2.84 mm",
      "unit": "mm",
      "comment": "envelope top above the seating plane",
      "model": false
    },
    {
      "name": "bend_span",
      "expr": "17.52 mm",
      "unit": "mm",
      "comment": "over the leads' downward legs",
      "model": false
    },
    {
      "name": "span",
      "expr": "19.3 mm",
      "unit": "mm",
      "comment": "overall length over the feet",
      "model": false
    },
    {
      "name": "lead_diameter",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "lead wire diameter (est.)",
      "model": false
    },
    {
      "name": "foot_width",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "flattened foot width",
      "model": false
    },
    {
      "name": "foot_thickness",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "flattened foot thickness (est.)",
      "model": false
    },
    {
      "name": "seal_length",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "tapered seal length at each end (est.)",
      "model": false
    },
    {
      "name": "seal_diameter",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "diameter at the seal's tip (est.)",
      "model": false
    },
    {
      "name": "wall",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "glass wall thickness (est.)",
      "model": false
    },
    {
      "name": "blade_width",
      "expr": "0.45 mm",
      "unit": "mm",
      "comment": "reed blade width (est.)",
      "model": false
    },
    {
      "name": "blade_thickness",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "reed blade thickness (est.)",
      "model": false
    },
    {
      "name": "blade_overlap",
      "expr": "0.8 mm",
      "unit": "mm",
      "comment": "reed blades' overlap at the centre (est.)",
      "model": false
    },
    {
      "name": "contact_gap",
      "expr": "0.05 mm",
      "unit": "mm",
      "comment": "gap between the open blades (est.)",
      "model": false
    },
    {
      "name": "axis_z",
      "expr": "height - tube_diameter / 2",
      "unit": "mm",
      "comment": "envelope axis height",
      "model": false
    },
    {
      "name": "seal_taper",
      "expr": "atan2((tube_diameter - seal_diameter) / 2, seal_length)",
      "unit": "deg",
      "comment": "the seals' taper",
      "model": false
    },
    {
      "name": "leg_x",
      "expr": "bend_span / 2 - lead_diameter / 2",
      "unit": "mm",
      "comment": "leg centre x",
      "model": false
    },
    {
      "name": "blade_tip",
      "expr": "blade_overlap / 2",
      "unit": "mm",
      "comment": "how far a blade reaches past the centre",
      "model": false
    },
    {
      "name": "d2",
      "expr": "tube_diameter",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d5",
      "expr": "seal_diameter",
