  "name": "Molded two-terminal, flat leads, band",
  "units": "mm",
  "params": [
    {
      "name": "body_length",
      "expr": "2.7 mm",
      "unit": "mm",
      "comment": "moulded body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "moulded body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "1.1 mm",
      "unit": "mm",
      "comment": "body top above the seating plane",
      "model": false
    },
    {
      "name": "span",
      "expr": "3.7 mm",
      "unit": "mm",
      "comment": "overall length, tip to tip",
      "model": false
    },
    {
      "name": "terminal_length",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "terminal contact length on the seating plane, from the tip",
      "model": false
    },
    {
      "name": "terminal_width",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "terminal width (y)",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.12 mm",
      "unit": "mm",
      "comment": "leadframe thickness",
      "model": false
    },
    {
      "name": "lead_root",
      "expr": "0.25 mm",
      "unit": "mm",
      "comment": "how far a lead reaches into the body",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.128 mm",
      "unit": "mm",
      "comment": "round of the body's upright corners",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.128 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "lead_length",
      "expr": "0.75 mm",
      "unit": "mm",
      "comment": "flat lead length from the tip inward",
      "model": false
    },
    {
      "name": "band_width",
      "expr": "0.15 * body_length",
      "unit": "mm",
      "comment": "polarity band length along x",
      "model": false
    },
    {
      "name": "band_start",
      "expr": "- body_length / 2 + 0.08 * body_length",
      "unit": "mm",
      "comment": "polarity band's end towards terminal 1",
      "model": false
    },
    {
      "name": "band_across",
      "expr": "0.8 * body_width",
      "unit": "mm",
      "comment": "polarity band across the body",
      "model": false
    },
    {
      "name": "band_depth",
      "expr": "0.03 mm",
      "unit": "mm",
      "comment": "how deep the band is inlaid",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "(body_length / 2 - 0.08 * body_length) - (band_start + band_width)",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.8 * body_width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    }
  ],
