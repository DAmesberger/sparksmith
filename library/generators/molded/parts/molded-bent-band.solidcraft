        "d2",
        "d3"
      ],
      "type": "box",
      "corner": [
        "- body_length / 2",
        "- body_width / 2",
        "body_bottom"
      ],
      "length": "body_length",
      "width": "body_width",
      "height": "body_height - body_bottom",
      "operation": "new_body"
    },
