    {
      "id": 5,
      "name": "row_s profile",
      "suppressed": false,
      "param_names": [
        "d8"
      ],
      "type": "sketch",
      "plane": {
        "type": "offset",
        "base": {
          "type": "origin",
          "name": "YZ"
        },
        "distance": "-(leads - 1) / 2 * pitch - lead_width / 2"
      },
      "sketch": {
        "points": [
          {
            "id": "origin",
            "pos": [
              0.0,
              0.0
            ],
            "fixed": true
          },
          {
            "id": "w1",
            "pos": [
              -3.25,
              0.8724999999999999
            ],
            "fixed": true,
            "exprs": {
              "x": "-(body_width / 2 - y_root)",
              "y": "(lead_exit + lead_thickness / 2)"
            }
          },
          {
            "id": "w2",
            "pos": [
              -3.52043869656275,
              0.8724999999999999
            ],
            "fixed": true,
            "exprs": {
              "x": "-(y_shoulder - y_tb)",
              "y": "(lead_exit + lead_thickness / 2)"
            }
          },
          {
            "id": "w3",
            "pos": [
              -3.7234233826471383,
              0.733124690176809
            ],
            "fixed": true,
            "exprs": {
              "x": "-(y_shoulder + y_tb * y_ux + lead_thickness / 2 * y_uz)",
              "y": "(lead_exit - y_tb * y_uz + lead_thickness / 2 * y_ux)"
            }
          },
          {
            "id": "w4",
            "pos": [
              -3.931899741409121,
              0.19145843660773026
            ],
            "fixed": true,
            "exprs": {
              "x": "-(y_foot - y_tc * y_ux + lead_thickness / 2 * y_uz)",
              "y": "(lead_thickness / 2 + y_tc * y_uz + lead_thickness / 2 * y_ux)"
            }
          },
          {
            "id": "w5",
            "pos": [
              -3.99956130343725,
              0.145
            ],
            "fixed": true,
            "exprs": {
              "x": "-(y_foot + y_tc)",
              "y": "(lead_thickness)"
            }
          },
          {
            "id": "w6",
            "pos": [
              -4.5,
              0.145
            ],
            "fixed": true,
            "exprs": {
              "x": "-(span / 2)",
              "y": "(lead_thickness)"
            }
          },
          {
            "id": "w7",
            "pos": [
              -4.5,
              0.0
            ],
            "fixed": true,
            "exprs": {
              "x": "-(span / 2)"
            }
          },
          {
            "id": "w8",
            "pos": [
              -3.99956130343725,
              0.0
            ],
            "fixed": true,
            "exprs": {
              "x": "-(y_foot + y_tc)"
            }
          },
          {
            "id": "w9",
            "pos": [
              -3.7965766173528617,
              0.13937530982319085
            ],
            "fixed": true,
            "exprs": {
              "x": "-(y_foot - y_tc * y_ux - lead_thickness / 2 * y_uz)",
              "y": "(lead_thickness / 2 + y_tc * y_uz - lead_thickness / 2 * y_ux)"
            }
          },
          {
            "id": "w10",
            "pos": [
              -3.588100258590879,
              0.6810415633922696
            ],
            "fixed": true,
            "exprs": {
              "x": "-(y_shoulder + y_tb * y_ux - lead_thickness / 2 * y_uz)",
              "y": "(lead_exit - y_tb * y_uz - lead_thickness / 2 * y_ux)"
            }
          },
          {
