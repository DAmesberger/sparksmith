{
  "format": "solidcraft/57",
  "format_pending": [
    "cell-grid-margin",
    "extrude-to-object-keeps-picked-placements",
    "hole-thread-class",
    "linked-configuration",
    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "Gull-wing package, four sides (QFP)",
  "units": "mm",
  "params": [
    {
      "name": "leads",
      "expr": "12",
      "unit": "",
      "comment": "leads on each long side (±y)",
      "model": false
    },
    {
      "name": "leads_short",
      "expr": "12",
      "unit": "",
      "comment": "leads on each short side (±x)",
      "model": false
    },
    {
      "name": "pitch",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "lead pitch",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "7 mm",
      "unit": "mm",
      "comment": "moulded body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "7 mm",
      "unit": "mm",
      "comment": "moulded body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "1.4 mm",
      "unit": "mm",
      "comment": "moulded body height above its underside",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0.1 mm",
      "unit": "mm",
      "comment": "seating plane to the body's underside",
      "model": false
    },
    {
      "name": "span",
      "expr": "9 mm",
      "unit": "mm",
      "comment": "lead tip to tip across y",
      "model": false
    },
    {
      "name": "span_x",
      "expr": "9 mm",
      "unit": "mm",
      "comment": "lead tip to tip across x",
      "model": false
    },
    {
      "name": "lead_width",
      "expr": "0.22 mm",
      "unit": "mm",
      "comment": "lead width",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.145 mm",
      "unit": "mm",
      "comment": "lead thickness",
      "model": false
    },
    {
      "name": "foot_length",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "flat foot length on the seating plane",
      "model": false
    },
    {
      "name": "lead_exit",
      "expr": "standoff + body_height / 2",
      "unit": "mm",
      "comment": "where the leads leave the body: mid-height",
      "model": false
    },
    {
      "name": "y_root",
      "expr": "min(0.25 mm, body_width / 2 / 3)",
      "unit": "mm",
      "comment": "how far a lead root reaches into the body (y rows)",
      "model": false
    },
    {
      "name": "y_foot",
      "expr": "span / 2 - foot_length",
      "unit": "mm",
      "comment": "where the foot begins (y rows)",
      "model": false
    },
    {
      "name": "y_shoulder",
      "expr": "body_width / 2 + 0.3 * (y_foot - body_width / 2)",
      "unit": "mm",
      "comment": "where the lead turns down (y rows)",
      "model": false
    },
    {
      "name": "y_dx",
      "expr": "y_foot - y_shoulder",
      "unit": "mm",
      "comment": "the sloped segment's run (y rows)",
      "model": false
    },
    {
      "name": "y_dz",
      "expr": "lead_exit - lead_thickness / 2",
      "unit": "mm",
      "comment": "the sloped segment's drop (y rows)",
      "model": false
    },
    {
      "name": "y_len",
      "expr": "hypot(y_dx, y_dz)",
      "unit": "mm",
      "comment": "the sloped segment's length (y rows)",
      "model": false
    },
    {
      "name": "y_half",
      "expr": "y_dz / (y_len + y_dx)",
      "unit": "",
      "comment": "tan of half the bend angle (y rows)",
      "model": false
    },
    {
      "name": "y_ux",
      "expr": "y_dx / y_len",
      "unit": "",
      "comment": "the sloped segment's direction along s (y rows)",
      "model": false
    },
    {
      "name": "y_uz",
      "expr": "y_dz / y_len",
      "unit": "",
      "comment": "the sloped segment's drop per length (y rows)",
      "model": false
    },
    {
      "name": "y_bend_b",
      "expr": "max(min(lead_thickness, 0.45 * min(y_root + 0.3 * (y_foot - body_width / 2), y_len) / y_half), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "centreline radius of the upper bend (y rows)",
      "model": false
    },
    {
      "name": "y_bend_c",
      "expr": "max(min(lead_thickness, 0.45 * min(y_len, foot_length) / y_half), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "centreline radius of the lower bend (y rows)",
      "model": false
    },
    {
      "name": "y_tb",
      "expr": "y_bend_b * y_half",
      "unit": "mm",
      "comment": "the upper bend's tangent length (y rows)",
      "model": false
    },
    {
      "name": "y_tc",
      "expr": "y_bend_c * y_half",
      "unit": "mm",
      "comment": "the lower bend's tangent length (y rows)",
      "model": false
    },
    {
      "name": "x_root",
      "expr": "min(0.25 mm, body_length / 2 / 3)",
      "unit": "mm",
      "comment": "how far a lead root reaches into the body (x rows)",
      "model": false
    },
    {
      "name": "x_foot",
      "expr": "span_x / 2 - foot_length",
      "unit": "mm",
      "comment": "where the foot begins (x rows)",
      "model": false
    },
    {
      "name": "x_shoulder",
      "expr": "body_length / 2 + 0.3 * (x_foot - body_length / 2)",
      "unit": "mm",
      "comment": "where the lead turns down (x rows)",
      "model": false
    },
    {
      "name": "x_dx",
      "expr": "x_foot - x_shoulder",
      "unit": "mm",
      "comment": "the sloped segment's run (x rows)",
      "model": false
    },
    {
      "name": "x_dz",
      "expr": "lead_exit - lead_thickness / 2",
      "unit": "mm",
      "comment": "the sloped segment's drop (x rows)",
      "model": false
    },
    {
      "name": "x_len",
      "expr": "hypot(x_dx, x_dz)",
      "unit": "mm",
      "comment": "the sloped segment's length (x rows)",
      "model": false
    },
    {
      "name": "x_half",
      "expr": "x_dz / (x_len + x_dx)",
      "unit": "",
      "comment": "tan of half the bend angle (x rows)",
      "model": false
    },
    {
      "name": "x_ux",
      "expr": "x_dx / x_len",
      "unit": "",
      "comment": "the sloped segment's direction along s (x rows)",
      "model": false
    },
    {
      "name": "x_uz",
      "expr": "x_dz / x_len",
      "unit": "",
      "comment": "the sloped segment's drop per length (x rows)",
      "model": false
    },
    {
      "name": "x_bend_b",
      "expr": "max(min(lead_thickness, 0.45 * min(x_root + 0.3 * (x_foot - body_length / 2), x_len) / x_half), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "centreline radius of the upper bend (x rows)",
      "model": false
    },
    {
      "name": "x_bend_c",
      "expr": "max(min(lead_thickness, 0.45 * min(x_len, foot_length) / x_half), lead_thickness / 2 * 1.0001)",
      "unit": "mm",
      "comment": "centreline radius of the lower bend (x rows)",
      "model": false
    },
    {
      "name": "x_tb",
      "expr": "x_bend_b * x_half",
      "unit": "mm",
      "comment": "the upper bend's tangent length (x rows)",
      "model": false
    },
    {
      "name": "x_tc",
      "expr": "x_bend_c * x_half",
      "unit": "mm",
      "comment": "the lower bend's tangent length (x rows)",
      "model": false
    },
    {
      "name": "draft",
      "expr": "8 deg",
      "unit": "deg",
      "comment": "mould draft of the walls above and below the parting line (Microchip SOIC drawing C04-057: 5–15°)",
      "model": false
    },
    {
      "name": "draft_inset",
      "expr": "(standoff + body_height - lead_exit) * tan(draft)",
      "unit": "mm",
      "comment": "how far the top face's edge lies in from the parting line's",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "max(min(0.2 mm, 0.06 * min(body_length, body_width), (body_length - ((leads - 1) * pitch + lead_width)) / 4, (body_width - ((leads_short - 1) * pitch + lead_width)) / 4), draft_inset + 0.04 mm)",
      "unit": "mm",
      "comment": "round of the body's upright corners at the parting line, clear of the end leads",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "min(0.1 mm, 0.08 * body_height, (standoff + body_height - lead_exit - lead_thickness / 2) / 2, 0.6 * (corner_round - draft_inset))",
      "unit": "mm",
      "comment": "round of the body's top edges, clear of the lead exit and the top's corner arcs",
      "model": false
    },
    {
      "name": "dimple_radius",
      "expr": "min(max(0.08 * min(body_length, body_width), 0.15 mm), 0.5 mm)",
      "unit": "mm",
      "comment": "pin-1 dimple radius",
      "model": false
    },
    {
      "name": "dimple_depth",
      "expr": "0.04 mm",
      "unit": "mm",
      "comment": "pin-1 dimple depth",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "0.75 * (body_length - 2 * draft_inset)",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.2 * body_width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
      "name": "d2",
      "expr": "corner_round",
      "unit": "mm",
      "model": true
    }
  ],
