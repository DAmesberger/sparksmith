{
  "format": "solidcraft/57",
  "format_pending": [
    "cell-grid-margin",
    "extrude-to-object-keeps-picked-placements",
    "hole-thread-class",
    "linked-configuration",
    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "Bottom-entry SMD socket",
  "units": "mm",
  "params": [
    {
      "name": "rows",
      "expr": "2",
      "unit": "",
      "comment": "rows of positions (y)",
      "model": false
    },
    {
      "name": "pins",
      "expr": "3",
      "unit": "",
      "comment": "positions per row (x)",
      "model": false
    },
    {
      "name": "pitch",
      "expr": "2.54 mm",
      "unit": "mm",
      "comment": "pitch along a row",
      "model": false
    },
    {
      "name": "row_pitch",
      "expr": "2.54 mm",
      "unit": "mm",
      "comment": "pitch between rows",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "3.7 mm",
      "unit": "mm",
      "comment": "insulator top above the seating plane",
      "model": false
    },
    {
      "name": "pin_side",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "contact tail width",
      "model": false
    },
    {
      "name": "lead_in",
      "expr": "1.7272 mm",
      "unit": "mm",
      "comment": "entry lead-in's side at the face",
      "model": false
    },
    {
      "name": "entry",
      "expr": "1.016 mm",
      "unit": "mm",
      "comment": "square entry's side",
      "model": false
    },
    {
      "name": "entry_depth",
      "expr": "0.3556 mm",
      "unit": "mm",
      "comment": "lead-in's depth (45°)",
      "model": false
    },
    {
      "name": "cavity",
      "expr": "1.4224 mm",
      "unit": "mm",
      "comment": "contact cavity's side",
      "model": false
    },
    {
      "name": "leaf",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "contact leaf sheet",
      "model": false
    },
    {
      "name": "leaf_gap",
      "expr": "0.4572 mm",
      "unit": "mm",
      "comment": "gap between the two leaves",
      "model": false
    },
    {
      "name": "leaf_width",
      "expr": "0.8128 mm",
      "unit": "mm",
      "comment": "leaf width along x",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "round of the insulator's upright corners",
      "model": false
    },
    {
      "name": "x0",
      "expr": "- (pins - 1) / 2 * pitch",
      "unit": "mm",
      "comment": "pin 1's x (derived)",
      "model": false
    },
    {
      "name": "y0",
      "expr": "- (rows - 1) / 2 * row_pitch",
      "unit": "mm",
      "comment": "pin 1's y (derived)",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "insulator underside above the board",
      "model": false
    },
    {
      "name": "cavity_bottom",
      "expr": "standoff + entry_depth + 0.3 mm",
      "unit": "mm",
      "comment": "cavity's floor over the entry",
      "model": false
    },
    {
      "name": "cavity_top",
      "expr": "body_height - entry_depth - 0.3 mm",
      "unit": "mm",
      "comment": "cavity's roof under the top window",
      "model": false
    },
    {
      "name": "tail_span",
      "expr": "7.2 mm",
      "unit": "mm",
      "comment": "tails' tips across",
      "model": false
    },
    {
      "name": "tail_sheet",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "tail sheet thickness",
      "model": false
    },
    {
      "name": "tail_bend",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "tail bends' centreline radius",
      "model": false
    },
    {
      "name": "tail_y",
      "expr": "(row_pitch / 2 + cavity / 2 + rows * row_pitch / 2) / 2",
      "unit": "mm",
      "comment": "tails' upright in the long walls (derived)",
      "model": false
    },
    {
      "name": "d32",
      "expr": "(tail_bend) + (tail_sheet / 2)",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d33",
      "expr": "(tail_bend) - (tail_sheet / 2)",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d41",
      "expr": "(tail_bend) - (tail_sheet / 2)",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d42",
      "expr": "(tail_bend) + (tail_sheet / 2)",
      "unit": "mm",
      "model": true
    }
  ],
