  "name": "Tactile switch, square, top push",
  "units": "mm",
  "params": [
    {
      "name": "body_length",
      "expr": "4.5 mm",
      "unit": "mm",
      "comment": "base along x",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "4.5 mm",
      "unit": "mm",
      "comment": "base across (y), over the cover tabs",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "1.75 mm",
      "unit": "mm",
      "comment": "cover top above the seating plane (est.)",
      "model": false
    },
    {
      "name": "height",
      "expr": "3.8 mm",
      "unit": "mm",
      "comment": "plunger top above the seating plane",
      "model": false
    },
    {
      "name": "plunger_diameter",
      "expr": "2.5 mm",
      "unit": "mm",
      "comment": "plunger diameter",
      "model": false
    },
    {
      "name": "cover_thickness",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "cover sheet thickness (est.)",
      "model": false
    },
    {
      "name": "stud_diameter",
      "expr": "0.7 mm",
      "unit": "mm",
      "comment": "cover corner stud diameter (est.)",
      "model": false
    },
    {
