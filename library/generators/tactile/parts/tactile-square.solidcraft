      "expr": "0.25 mm",
      "unit": "mm",
      "comment": "cover corner stud height (est.)",
      "model": false
    },
    {
      "name": "span",
      "expr": "7.5 mm",
      "unit": "mm",
      "comment": "overall length over the terminals",
      "model": false
    },
    {
      "name": "terminal_width",
      "expr": "0.7 mm",
      "unit": "mm",
      "comment": "terminal width",
      "model": false
    },
    {
      "name": "terminal_pitch",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "terminal centres across (y)",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "terminal sheet thickness",
      "model": false
    },
    {
      "name": "lead_exit",
      "expr": "0.7 mm",
      "unit": "mm",
      "comment": "terminal top where it leaves the base (est.)",
      "model": false
    },
    {
      "name": "lead_gap",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "gap between the base and a terminal's leg (est.)",
      "model": false
    },
    {
      "name": "lead_root",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "how far a terminal reaches into the base (est.)",
      "model": false
    },
    {
      "name": "tab_length",
      "expr": "1.2 mm",
      "unit": "mm",
      "comment": "cover side tab along x (est.)",
      "model": false
    },
    {
      "name": "d15",
      "expr": "stud_diameter",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d18",
      "expr": "stud_diameter",
      "unit": "mm",
      "model": true
