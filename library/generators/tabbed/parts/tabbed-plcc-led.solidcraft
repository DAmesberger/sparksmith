{
  "format": "solidcraft/57",
  "format_pending": [
    "cell-grid-margin",
    "extrude-to-object-keeps-picked-placements",
    "hole-thread-class",
    "linked-configuration",
    "linked-cosmetic-threads",
    "plane-at-angle-follows-named-axis",
    "thread-multiple-faces"
  ],
  "name": "PLCC LED package",
  "units": "mm",
  "params": [
    {
      "name": "pitch",
      "expr": "3.3 mm",
      "unit": "mm",
      "comment": "the lead grid's pitch along x",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "5 mm",
      "unit": "mm",
      "comment": "body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "5 mm",
      "unit": "mm",
      "comment": "body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "1.42 mm",
      "unit": "mm",
      "comment": "body height above the standoff",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "body bottom above the seating plane: the feet under it",
      "model": false
    },
    {
      "name": "span",
      "expr": "5.4 mm",
      "unit": "mm",
      "comment": "lead tip to lead tip across y",
      "model": false
    },
    {
      "name": "lead_width",
      "expr": "0.9 mm",
      "unit": "mm",
      "comment": "lead width along x",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "lead thickness",
      "model": false
    },
    {
      "name": "foot_length",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "a lead's foot under the body, from its outer face",
      "model": false
    },
    {
      "name": "row_s_leads",
      "expr": "2",
      "unit": "",
      "comment": "leads on the −y side",
      "model": false
    },
    {
      "name": "row_s_step",
      "expr": "1",
      "unit": "",
      "comment": "grid positions between −y leads",
      "model": false
    },
    {
      "name": "row_n_leads",
      "expr": "2",
      "unit": "",
      "comment": "leads on the +y side",
      "model": false
    },
    {
      "name": "row_n_step",
      "expr": "1",
      "unit": "",
      "comment": "grid positions between +y leads",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.1 mm",
      "unit": "mm",
      "comment": "round of the body's upright corners",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.05 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "lead_exit",
      "expr": "standoff + min(0.5 mm, body_height / 3)",
      "unit": "mm",
      "comment": "height of the lead's centreline where it leaves the body (est.)",
      "model": false
    },
    {
      "name": "lens_diameter",
      "expr": "0.78 * min(body_length, body_width)",
      "unit": "mm",
      "comment": "the cavity's diameter at the top (WS2812B drawing: about 3.9 of 5 mm)",
      "model": false
    },
    {
      "name": "lens_depth",
      "expr": "0.45 * body_height",
      "unit": "mm",
      "comment": "the cavity's depth to the leadframe (est.)",
      "model": false
    },
    {
      "name": "notch",
      "expr": "0.4 mm",
      "unit": "mm",
      "comment": "the cut corner over pin 3 (WS2812B drawing)",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "0.5 * body_length",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.1 * body_width",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
      "name": "d7",
      "expr": "lens_diameter",
      "unit": "mm",
      "model": true
    }
  ],
