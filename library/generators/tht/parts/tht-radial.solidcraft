  "name": "Radial through-hole part",
  "units": "mm",
  "params": [
    {
      "name": "lead_pitch",
      "expr": "2 mm",
      "unit": "mm",
      "comment": "lead pitch on the board",
      "model": false
    },
    {
      "name": "lead_diameter",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "lead diameter (a strip's width, a square lead's side)",
      "model": false
    },
    {
      "name": "lead_below",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "lead length below the seating plane",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0 mm",
      "unit": "mm",
      "comment": "body underside above the seating plane",
      "model": false
    },
    {
      "name": "root",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "how far each lead reaches into the body",
      "model": false
    },
    {
      "name": "body_diameter",
      "expr": "5 mm",
      "unit": "mm",
      "comment": "body diameter",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "11 mm",
      "unit": "mm",
      "comment": "body height above its standoff",
      "model": false
    },
    {
      "name": "top_round",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "round of the body's top edge",
      "model": false
    },
    {
      "name": "marking_top_u",
      "expr": "0.8 * (body_diameter - 2 * top_round)",
      "unit": "mm",
      "comment": "marking-top size along its u axis",
      "model": false
    },
    {
      "name": "marking_top_v",
      "expr": "0.6 * (body_diameter - 2 * top_round)",
      "unit": "mm",
      "comment": "marking-top size across it",
      "model": false
    },
    {
      "name": "d2",
      "expr": "body_diameter / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d5",
      "expr": "lead_diameter / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d8",
      "expr": "lead_diameter / 2",
      "unit": "mm",
      "model": true
    }
  ],
