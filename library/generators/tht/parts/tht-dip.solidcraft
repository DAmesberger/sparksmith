{
  "format": "solidcraft/52",
  "format_pending": [
    "3d-wire-point-nodes",
    "frame-end-caps",
    "joint-origin-inside",
    "nested-face-name",
    "opus-quality",
    "render-indirect-clamp",
    "render-quality-controls",
    "revolve-axis-sketch",
    "sheet-flange-segments",
    "sketch-link-construction-point",
    "two-sided-cut-cap-names"
  ],
  "name": "Dual in-line package",
  "units": "mm",
  "params": [
    {
      "name": "per_row",
      "expr": "4",
      "unit": "",
      "comment": "leads in each row (x)",
      "model": false
    },
    {
      "name": "lead_pitch",
      "expr": "2.54 mm",
      "unit": "mm",
      "comment": "lead pitch on the board",
      "model": false
    },
    {
      "name": "lead_diameter",
      "expr": "0.46 mm",
      "unit": "mm",
      "comment": "lead diameter (a strip's width, a square lead's side)",
      "model": false
    },
    {
      "name": "lead_below",
      "expr": "3.3 mm",
      "unit": "mm",
      "comment": "lead length below the seating plane",
      "model": false
    },
    {
      "name": "standoff",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "body underside above the seating plane",
      "model": false
    },
    {
      "name": "root",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "how far each lead reaches into the body",
      "model": false
    },
    {
      "name": "row_pitch",
      "expr": "7.62 mm",
      "unit": "mm",
      "comment": "pitch between the rows (y)",
      "model": false
    },
    {
      "name": "lead_thickness",
      "expr": "0.25 mm",
      "unit": "mm",
      "comment": "lead strip thickness",
      "model": false
    },
    {
      "name": "lead_exit",
      "expr": "1.49 mm",
      "unit": "mm",
      "comment": "height at which the leads leave the body",
      "model": false
    },
    {
      "name": "bend_radius",
      "expr": "0.46 mm",
      "unit": "mm",
      "comment": "centreline radius of the lead bends",
      "model": false
    },
    {
      "name": "body_length",
      "expr": "9.27 mm",
      "unit": "mm",
      "comment": "body length (x)",
      "model": false
    },
    {
      "name": "body_width",
      "expr": "6.35 mm",
      "unit": "mm",
      "comment": "body width (y)",
      "model": false
    },
    {
      "name": "body_height",
      "expr": "3.3 mm",
      "unit": "mm",
      "comment": "body height above its standoff",
      "model": false
    },
    {
      "name": "corner_round",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "round of the body's upright corners",
      "model": false
    },
    {
      "name": "edge_round",
      "expr": "0.2 mm",
      "unit": "mm",
      "comment": "round of the body's top edges",
      "model": false
    },
    {
      "name": "row_s_r1",
      "expr": "max(min(bend_radius, 0.45 * min(abs(((-(row_pitch / 2)) - (-(body_width / 2 - root)))), abs(((- lead_below) - lead_exit))) / 1), (lead_thickness / 2) * 1.0001)",
      "unit": "mm",
      "comment": "row_s bend 1: centreline radius",
      "model": false
    },
    {
      "name": "row_s_t1",
      "expr": "row_s_r1",
      "unit": "mm",
      "comment": "row_s bend 1: tangent length",
      "model": false
    },
    {
      "name": "row_n_r1",
      "expr": "max(min(bend_radius, 0.45 * min(abs(((row_pitch / 2) - (body_width / 2 - root))), abs(((- lead_below) - lead_exit))) / 1), (lead_thickness / 2) * 1.0001)",
      "unit": "mm",
      "comment": "row_n bend 1: centreline radius",
      "model": false
    },
    {
      "name": "row_n_t1",
      "expr": "row_n_r1",
      "unit": "mm",
      "comment": "row_n bend 1: tangent length",
      "model": false
    }
  ],
